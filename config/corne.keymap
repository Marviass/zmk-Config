#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// Скорость курсора (по умолчанию 600) и скролла (по умолчанию 10) - задаётся до include
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#include <dt-bindings/zmk/pointing.h>

/*
 * Слои:
 *   0 default  - QWERTY
 *   1 lower    - нампад (правая рука) + стрелки/навигация (левая рука)
 *   2 raise    - символы, Bluetooth-профили
 *   3 adjust   - F-клавиши, медиа, прошивка (raise + левый внешний большой палец)
 *   4 BDO      - игровой слой (переключается из adjust)
 *   5 mouse    - мышь: удерживать правый внешний большой палец на слое lower
 */

/ {
    combos {
        compatible = "zmk,combos";

        // Левый Shift + правый Shift одновременно = смена языка (Win+Space).
        // Если нужен Alt+Shift или Ctrl+Shift, замени LG(SPACE) на LA(LSHFT) / LC(LSHFT).
        lang_switch {
            timeout-ms = <50>;
            key-positions = <24 35>;
            bindings = <&kp LG(SPACE)>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R    &kp T        &kp Y    &kp U    &kp I      &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D      &kp F    &kp G        &kp H    &kp J    &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V    &kp B        &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LCTRL  &mo 1    &kp SPACE    &kp RET  &mo 2    &kp RALT
            >;
        };

        lower_layer {
            label = "NUM_NAV";
            bindings = <
&trans  &kp HOME  &kp UP    &kp END    &kp PG_UP  &kp DEL      &kp N7  &kp N8  &kp N9  &kp FSLH   &kp STAR   &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &trans       &kp N4  &kp N5  &kp N6  &kp MINUS  &kp PLUS   &kp RET
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp CAPS     &kp N1  &kp N2  &kp N3  &kp PERIOD &kp COMMA  &kp EQUAL
                            &trans     &trans     &kp SPACE    &kp RET &kp N0  &mo 5
            >;
        };

        raise_layer {
            label = "SYMBOL";
            bindings = <
&kp TAB    &kp EXCL        &kp AT        &kp HASH      &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp DEL
&kp LCTRL  &bt BT_SEL 0    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1 &kp MINUS  &kp PLUS   &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&sk LSHFT  &bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans       &kp UNDER  &kp EQUAL  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                                         &mo 3         &trans        &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        adjust_layer {
            label = "Fkeys";
            bindings = <
&bootloader     &sys_reset  &trans  &trans  &trans  &trans    &kp F9  &kp F10  &kp F11  &kp F12  &kp C_RANDOM_PLAY  &kp C_PLAY_PAUSE
&studio_unlock  &trans      &trans  &trans  &trans  &trans    &kp F5  &kp F6   &kp F7   &kp F8   &kp C_VOL_DN       &kp C_VOLUME_UP
&trans          &trans      &trans  &trans  &trans  &trans    &kp F1  &kp F2   &kp F3   &kp F4   &kp C_PREVIOUS     &kp C_NEXT
                                    &trans  &trans  &trans    &tog 4  &trans   &kp RIGHT_ALT
            >;
        };

        BDO {
            label = "BDO";
            bindings = <
&trans  &trans  &trans  &trans        &trans  &trans    &kp N7        &kp NUMBER_8  &kp N9        &trans        &trans  &mkp LCLK
&trans  &trans  &trans  &trans        &kp F2  &trans    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp NUMBER_0  &trans  &mkp RCLK
&trans  &trans  &trans  &kp NUMBER_1  &kp F3  &trans    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &trans  &mkp MCLK
                        &trans        &trans  &trans    &trans        &trans        &kp U
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans      &trans      &msc SCRL_UP    &trans      &none  &none           &mmv MOVE_UP    &none            &none  &none
&trans  &trans  &mkp MCLK   &mkp RCLK   &mkp LCLK       &trans      &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&trans  &trans  &trans      &trans      &msc SCRL_DOWN  &trans      &none  &none           &none           &none            &none  &none
                            &trans      &trans          &trans      &trans &trans          &trans
            >;
        };
    };
};
