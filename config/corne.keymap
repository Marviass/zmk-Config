#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// Скорость курсора (по умолчанию 600) и скролла (по умолчанию 10) - задаётся до include
#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#include <dt-bindings/zmk/pointing.h>

/*
 * Слои (порядок важен, номера используются в &mo / &tog):
 *   0 QWERTY    - основной
 *   1 RU_STATE  - невидимый слой "сейчас русский язык": меняет только две клавиши , и .
 *   2 LOWER     - нампад (правая рука) + стрелки/навигация (левая рука)
 *   3 RAISE     - символы, Bluetooth-профили
 *   4 F-KEYS    - F1-F12, медиа, прошивка (удерживая RAISE, нажать левый внешний большой палец)
 *   5 MOUSE     - мышь (одновременно Space + Enter)
 *   6 CLIPBOARD - копировать/вставить на правой руке (удерживать правый внешний большой палец)
 */

/ {
    behaviors {
        // Липкий Shift: нажал, отпустил, следующая клавиша будет с Shift.
        // quick-release снимает Shift сразу при нажатии следующей клавиши,
        // а если ничего не нажато, то он сам отпускается через 600 мс.
        sk_shift: sk_shift {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <600>;
            quick-release;
        };

        // Правый внешний большой палец: тап = липкий Win, удержание = слой CLIPBOARD
        lt_clip: lt_clip {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&sk>;
        };
    };

    macros {
        // Смена языка в системе + переключение внутреннего слоя RU_STATE
        lang_switch_macro: lang_switch_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>, <&tog 1>;
            label = "LANG_SWITCH";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Space + Enter (внутренние большие пальцы) = мышь, пока держишь
        mouse_mode {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <38 39>;
            bindings = <&mo 5>;
            layers = <0 1>;
        };

        // Левый и правый внешние большие пальцы вместе = смена языка (Win+Space)
        lang_switch {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <36 41>;
            bindings = <&lang_switch_macro>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&kp ESC          &kp Q  &kp W  &kp E      &kp R    &kp T        &kp Y    &kp U    &kp I      &kp O    &kp P      &kp BSPC
&kp TAB          &kp A  &kp S  &kp D      &kp F    &kp G        &kp H    &kp J    &kp K      &kp L    &kp SEMI   &kp SQT
&sk_shift LSHFT  &kp Z  &kp X  &kp C      &kp V    &kp B        &kp N    &kp M    &kp COMMA  &kp DOT  &kp COMMA  &kp DOT
                               &kp LCTRL  &mo 2    &kp SPACE    &kp RET  &mo 3    &lt_clip 6 LGUI
            >;
        };

        ru_layer {
            label = "RU_STATE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans         &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LS(FSLH)   &kp FSLH
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
&trans  &kp DEL   &kp HOME  &kp UP    &kp END    &kp PG_UP    &kp STAR   &kp N7  &kp N8  &kp N9  &kp FSLH  &trans
&trans  &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &kp MINUS  &kp N4  &kp N5  &kp N6  &kp EQUAL &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT  &kp CAPS     &kp PLUS   &kp N1  &kp N2  &kp N3  &trans    &trans
                            &trans    &trans     &kp SPACE    &kp RET    &kp N0  &trans
            >;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
&kp TAB          &kp EXCL        &kp AT        &kp HASH      &kp DLLR      &kp PRCNT       &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp FSLH
&kp LCTRL        &bt BT_SEL 0    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &kp MINUS  &kp PLUS   &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&sk_shift LSHFT  &bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans          &kp UNDER  &kp EQUAL  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                                               &mo 4         &trans        &kp SPACE       &kp RET    &trans     &kp RALT
            >;
        };

        fkeys_layer {
            label = "F-KEYS";
            bindings = <
&bootloader     &sys_reset  &trans  &trans  &trans  &trans    &kp F9  &kp F10  &kp F11  &kp F12  &kp C_RANDOM_PLAY  &kp C_PLAY_PAUSE
&studio_unlock  &trans      &trans  &trans  &trans  &trans    &kp F5  &kp F6   &kp F7   &kp F8   &kp C_VOL_DN       &kp C_VOLUME_UP
&trans          &tog 1      &trans  &trans  &trans  &trans    &kp F1  &kp F2   &kp F3   &kp F4   &kp C_PREVIOUS     &kp C_NEXT
                                    &trans  &trans  &trans    &trans  &trans   &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans      &trans      &msc SCRL_UP    &trans      &none  &none           &mmv MOVE_UP    &none            &none  &none
&trans  &trans  &mkp MCLK   &mkp RCLK   &mkp LCLK       &trans      &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&trans  &trans  &trans      &trans      &msc SCRL_DOWN  &trans      &none  &none           &none           &none            &none  &none
                            &trans      &trans          &trans      &trans &trans          &trans
            >;
        };

        clip_layer {
            label = "CLIPBOARD";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &none       &kp LC(Z)  &kp LC(Y)  &none      &none  &none
&trans  &trans  &trans  &trans  &trans  &trans    &kp LC(A)   &kp LC(C)  &kp LC(V)  &kp LC(X)  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans    &none       &none      &none      &none      &none  &none
                        &trans  &trans  &trans    &trans      &trans     &trans
            >;
        };
    };
};
